  "direct_run_formatting_runs": 276,
  "direct_paragraph_formatting_paragraphs": 216,
  "heading_like_paragraphs_not_heading_style": [
    {
      "para_index": 2,
      "text": "\u6280\u672f\u539f\u7406 \u00b7 \u516c\u5f0f\u5206\u6790 \u00b7 \u4eff\u771f\u793a\u4f8b \u00b7 \u8bb2\u89e3\u6307\u5357",
      "style": "Normal"
    },
    {
      "para_index": 3,
      "text": "\u8230\u8247\u78c1\u573a\u7279\u6027\u4eff\u771f",
      "style": "Normal"
    },
    {
      "para_index": 5,
      "text": "B_anom = B_static + B_induced",
      "style": "Normal"
    },
    {
      "para_index": 11,
      "text": "\u4e00\u53e5\u8bdd\u8bf4\u660e\uff1a\u8230\u8247\u76f8\u5f53\u4e8e\u4e00\u4e2a\u4f1a\u88ab\u5730\u78c1\u201c\u78c1\u5316\u201d\u3001\u540c\u65f6\u53c8\u4fdd\u7559\u81ea\u8eab\u5269\u78c1\u7684\u5927\u78c1\u4f53\uff1b\u6a21\u578b\u628a\u590d\u6742\u8230\u4f53\u7b80\u5316\u4e3a\u78c1\u6027\u692d\u7403\uff0c\u518d\u8ba1\u7b97\u5b83\u5728\u4f20\u611f\u5668\u5904\u4ea7\u751f\u7684\u5f02\u5e38\u78c1\u573a\u3002",
      "style": "Callout"
    },
    {
      "para_index": 29,
      "text": "B_anom = B_static + B_induced\n\u7efc\u5408\u76ee\u6807\u5f02\u5e38\u78c1\u573a = \u76ee\u6807\u5269\u78c1\u4ea7\u751f\u7684\u9759\u78c1\u573a + \u5730\u78c1\u78c1\u5316\u4ea7\u751f\u7684\u611f\u5e94\u78c1\u573a\u3002",
      "style": "Equation Block"
    },
    {
      "para_index": 37,
      "text": "\u5355\u4f4d\u63d0\u9192\uff1a\u8f93\u5165\u5355\u4f4d\u5fc5\u987b\u662f nT\u3002\u82e5\u4eea\u5668\u7ed9\u51fa \u03bcT\uff0c\u9700\u8981\u4e58\u4ee5 1000\uff1b\u82e5\u7ed9\u51fa\u5317-\u4e1c-\u4e0b\u5206\u91cf X\u3001Y\u3001Z\uff0c\u5e94\u8f6c\u6362\u4e3a {\u4e1c Y\uff0c\u5317 X\uff0c\u4e0a -Z}\u3002",
      "style": "Callout"
    },
    {
      "para_index": 41,
      "text": "a = L/2,    b = W/2,    c = H/2\na\u3001b\u3001c \u662f\u7b49\u6548\u692d\u7403\u4e09\u4e2a\u534a\u8f74\u3002",
      "style": "Equation Block"
    },
    {
      "para_index": 42,
      "text": "V_e = 4\u03c0abc/3 = \u03c0LWH/6,    V_m = \u03b7V_e\nV_e \u4e3a\u51e0\u4f55\u4f53\u79ef\uff0c\u03b7 \u4e3a\u78c1\u6027\u6750\u6599\u7b49\u6548\u4f53\u79ef\u5360\u6bd4\uff0cV_m \u4e3a\u53c2\u4e0e\u78c1\u5316\u7684\u7b49\u6548\u78c1\u6027\u4f53\u79ef\u3002",
      "style": "Equation Block"
    },
    {
      "para_index": 43,
      "text": "\u793a\u4f8b\uff1a\u957f 100 m\u3001\u5bbd 15 m\u3001\u9ad8 10 m \u7684\u7b49\u6548\u692d\u7403\u4f53\u79ef\u7ea6\u4e3a 7,854.0 m\u00b3\uff1b\u5f53 \u03b7=0.035 \u65f6\uff0c\u7b49\u6548\u78c1\u6027\u4f53\u79ef\u7ea6\u4e3a 274.9 m\u00b3\u3002",
      "style": "Callout"
    },
    {
      "para_index": 52,
      "text": "N_x + N_y + N_z = 1\n\u7ec6\u957f\u76ee\u6807\u7684\u7eb5\u5411\u9000\u78c1\u56e0\u5b50\u901a\u5e38\u8f83\u5c0f\uff0c\u56e0\u6b64\u66f4\u5bb9\u6613\u6cbf\u7eb5\u5411\u88ab\u78c1\u5316\u3002",
      "style": "Equation Block"
    },
    {
      "para_index": 54,
      "text": "\u03c7 = \u03bc_r - 1,    H_g = B_g / \u03bc\u2080\n\u03c7 \u662f\u78c1\u5316\u7387\uff1b\u5730\u78c1 B \u9700\u5148\u6362\u7b97\u4e3a\u78c1\u573a\u5f3a\u5ea6 H\u3002",
      "style": "Equation Block"
    },
    {
      "para_index": 55,
      "text": "m_i,k = V_m \u03c7 H_g,k / (1 + N_k \u03c7)\n\u5206\u6bcd\u4e2d\u7684\u9000\u78c1\u9879\u4f1a\u9650\u5236\u9ad8\u78c1\u5bfc\u7387\u6750\u6599\u7684\u6709\u6548\u78c1\u5316\u7a0b\u5ea6\u3002",
      "style": "Equation Block"
    },
    {
      "para_index": 57,
      "text": "\u8bb2\u89e3\u6bd4\u55bb\uff1a\u5730\u78c1\u50cf\u5916\u90e8\u63a8\u529b\uff0c\u6750\u6599\u78c1\u5316\u7387\u50cf\u201c\u5bb9\u6613\u88ab\u63a8\u52a8\u7684\u7a0b\u5ea6\u201d\uff0c\u9000\u78c1\u56e0\u5b50\u50cf\u8230\u4f53\u81ea\u8eab\u7684\u53cd\u4f5c\u7528\u3002\u7ec6\u957f\u65b9\u5411\u7684\u53cd\u4f5c\u7528\u8f83\u5f31\uff0c\u6240\u4ee5\u7eb5\u5411\u78c1\u5316\u66f4\u660e\u663e\u3002",
      "style": "Callout"
    },
    {
      "para_index": 61,
      "text": "B(r) = \u03bc\u2080/(4\u03c0r\u00b3) \u00b7 [3(m\u00b7r\u0302)r\u0302 - m]\nm \u4e3a\u78c1\u77e9\uff0cr \u4e3a\u76ee\u6807\u4e2d\u5fc3\u5230\u4f20\u611f\u5668\u7684\u4f4d\u79fb\uff0cr\u0302 \u4e3a\u5176\u5355\u4f4d\u65b9\u5411\u3002",
      "style": "Equation Block"
    },
    {
      "para_index": 62,
      "text": "B_static = Dipole(m_r),    B_induced = Dipole(m_i)\n\u9759\u78c1\u573a\u4e0e\u611f\u5e94\u78c1\u573a\u5206\u522b\u8ba1\u7b97\uff0c\u6700\u540e\u6309\u77e2\u91cf\u76f8\u52a0\u3002",
      "style": "Equation Block"
    },
    {
      "para_index": 65,
      "text": "\u4e3a\u4ec0\u4e48\u6700\u8fd1\u70b9\u6700\u91cd\u8981\uff1a\u573a\u5f3a\u7ea6\u6309 1/r\u00b3 \u8870\u51cf\u3002\u8ddd\u79bb\u589e\u5927\u5230 2 \u500d\u65f6\uff0c\u7406\u60f3\u5076\u6781\u573a\u7ea6\u964d\u4e3a 1/8\uff1b\u56e0\u6b64\u4f20\u611f\u5668\u6df1\u5ea6\u3001\u6a2a\u5411\u504f\u8ddd\u548c\u822a\u8ff9\u8bef\u5dee\u90fd\u4f1a\u663e\u8457\u6539\u53d8\u5cf0\u503c\u3002",
      "style": "Callout"
    },
    {
      "para_index": 69,
      "text": "r_c(t) = r\u2080 + R \u00b7 [v t, 0, 0]\u1d40\nr\u2080 \u4e3a\u96f6\u65f6\u523b\u4e2d\u5fc3\u4f4d\u7f6e\uff0cv \u4e3a\u6cbf\u8230\u9996\u65b9\u5411\u7684\u822a\u901f\u3002",
      "style": "Equation Block"
    },
    {
      "para_index": 70,
      "text": "d(t) = r_sensor - r_c(t)\n\u6bcf\u4e2a\u65f6\u523b\u91cd\u65b0\u8ba1\u7b97\u76ee\u6807\u5230\u56fa\u5b9a\u4f20\u611f\u5668\u7684\u4f4d\u79fb\u548c\u8ddd\u79bb\u3002",
      "style": "Equation Block"
    },
    {
      "para_index": 74,
      "text": "\u89c2\u5bdf\uff1a\u78c1\u573a\u5cf0\u503c\u4e0d\u4e00\u5b9a\u4e0e\u51e0\u4f55\u6700\u8fd1\u70b9\u5b8c\u5168\u91cd\u5408\uff0c\u56e0\u4e3a\u78c1\u5076\u6781\u573a\u8fd8\u53d6\u51b3\u4e8e\u78c1\u77e9\u65b9\u5411\u548c\u76ee\u6807-\u4f20\u611f\u5668\u8fde\u7ebf\u65b9\u5411\u3002",
      "style": "Callout"
    },
    {
      "para_index": 89,
      "text": "\u56fe\u50cf\u89e3\u8bfb\uff1a\u672c\u793a\u4f8b\u7efc\u5408\u5f02\u5e38\u78c1\u573a\u6700\u5927\u503c\u7ea6\u4e3a 1218.8 nT\uff0c\u4f4d\u7f6e\u7ea6\u4e3a (5, 0, -30) m\u3002\u9ad8\u573a\u533a\u96c6\u4e2d\u5728\u76ee\u6807\u9644\u8fd1\uff0c\u5e76\u6cbf\u76ee\u6807\u78c1\u77e9\u65b9\u5411\u5448\u73b0\u660e\u663e\u65b9\u5411\u6027\u3002",
      "style": "Callout"
    }
  ],
